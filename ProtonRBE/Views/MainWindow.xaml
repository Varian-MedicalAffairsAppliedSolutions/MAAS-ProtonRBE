<Window x:Class="ProtonRBE.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProtonRBE"
        xmlns:resx="clr-namespace:ProtonRBE.Resources"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:MainViewModel}"
        Title="RBE Calculator"
        WindowStartupLocation="CenterScreen"
        Background="#141414"
        Icon="pack://application:,,,/ProtonRBE.esapi;component/Resources/icon.png"
        Height="700" Width="700">

  <Window.Resources>
    <ResourceDictionary>
      <resx:InverterConverter x:Key="InverterConverter"/>
      <resx:BooleanToVisibilityConverter x:Key="BooleanToVisibleConverter"/>

      <!-- Palette -->
      <SolidColorBrush x:Key="PageBackgroundBrush" Color="#141414"/>
      <SolidColorBrush x:Key="CardBackgroundBrush" Color="#232323"/>
      <SolidColorBrush x:Key="InputBackgroundBrush" Color="#2E2E2E"/>
      <SolidColorBrush x:Key="InputHoverBrush" Color="#383838"/>
      <SolidColorBrush x:Key="PrimaryTextBrush" Color="#E6E6E6"/>
      <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A0A0A0"/>
      <SolidColorBrush x:Key="DisabledTextBrush" Color="#666666"/>
      <SolidColorBrush x:Key="AccentBrush" Color="#EC6602"/>
      <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF7A1A"/>
      <SolidColorBrush x:Key="ErrorBrush" Color="#E7001D"/>
      <SolidColorBrush x:Key="BorderBrush" Color="#4A4A4A"/>
      <SolidColorBrush x:Key="SelectionBrush" Color="#3A3A3A"/>

      <!-- Text -->
      <Style x:Key="Body1TextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
      </Style>
      <Style x:Key="Body2TextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
      </Style>

      <!-- Card -->
      <Style x:Key="CardStyle" TargetType="HeaderedContentControl">
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="HeaderedContentControl">
              <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="4" Padding="16 12">
                <DockPanel>
                  <ContentPresenter DockPanel.Dock="Top" ContentSource="Header" Margin="0 0 0 10"
                                    TextElement.FontSize="16" TextElement.FontWeight="SemiBold"
                                    TextElement.Foreground="{StaticResource PrimaryTextBrush}">
                    <ContentPresenter.Style>
                      <Style TargetType="ContentPresenter">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </ContentPresenter.Style>
                  </ContentPresenter>
                  <ContentPresenter ContentSource="Content"/>
                </DockPanel>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- DataGrid -->
      <Style x:Key="DataGridStyle" TargetType="DataGrid">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="RowBackground" Value="Transparent"/>
        <Setter Property="AlternatingRowBackground" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
        <Setter Property="CellStyle">
          <Setter.Value>
            <Style TargetType="DataGridCell">
              <Setter Property="BorderThickness" Value="0"/>
              <Setter Property="Padding" Value="6 6"/>
              <Setter Property="Background" Value="Transparent"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                      <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
              <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                  <Setter Property="Background" Value="Transparent"/>
                  <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                </Trigger>
              </Style.Triggers>
            </Style>
          </Setter.Value>
        </Setter>
        <Setter Property="RowStyle">
          <Setter.Value>
            <Style TargetType="DataGridRow">
              <Setter Property="Background" Value="Transparent"/>
              <Setter Property="BorderThickness" Value="3 0 0 0"/>
              <Setter Property="BorderBrush" Value="Transparent"/>
              <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Background" Value="{StaticResource InputHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter Property="Background" Value="{StaticResource SelectionBrush}"/>
                  <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </Trigger>
              </Style.Triggers>
            </Style>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="IsEnabled" Value="False">
            <Setter Property="Opacity" Value="0.5"/>
          </Trigger>
        </Style.Triggers>
      </Style>

      <!-- TextBox (floating hint, error message, optional clear button) -->
      <Style x:Key="TextBoxStyle" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
        <Setter Property="CaretBrush" Value="{StaticResource PrimaryTextBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="TextBox">
              <StackPanel>
                <Border x:Name="Bd" Background="{StaticResource InputBackgroundBrush}" CornerRadius="3 3 0 0"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0 0 0 1" MinHeight="44">
                  <Grid Margin="10 4 4 4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="Hint" Grid.Row="0" FontSize="11"
                               Text="{TemplateBinding local:TextBoxAssist.Hint}"
                               Foreground="{StaticResource SecondaryTextBrush}"/>
                    <ScrollViewer x:Name="PART_ContentHost" Grid.Row="1" VerticalAlignment="Center"
                                  Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    <Button x:Name="ClearButton" Grid.Column="1" Grid.RowSpan="2" Content="✕"
                            Width="24" Height="24" Margin="4 0 0 0" Focusable="False" Cursor="Hand"
                            VerticalAlignment="Center" Visibility="Collapsed"
                            Foreground="{StaticResource SecondaryTextBrush}" Click="ClearButton_Click">
                      <Button.Template>
                        <ControlTemplate TargetType="Button">
                          <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>
                        </ControlTemplate>
                      </Button.Template>
                    </Button>
                  </Grid>
                </Border>
                <TextBlock x:Name="ErrorText" FontSize="11" Margin="10 2 0 0" TextWrapping="Wrap"
                           Text="{TemplateBinding local:TextBoxAssist.ErrorMessage}"
                           Foreground="{StaticResource ErrorBrush}" Visibility="Collapsed"/>
              </StackPanel>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{StaticResource InputHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                  <Setter TargetName="Bd" Property="BorderThickness" Value="0 0 0 2"/>
                </Trigger>
                <MultiTrigger>
                  <MultiTrigger.Conditions>
                    <Condition Property="local:TextBoxAssist.ShowClearButton" Value="True"/>
                    <Condition Property="IsMouseOver" Value="True"/>
                  </MultiTrigger.Conditions>
                  <Setter TargetName="ClearButton" Property="Visibility" Value="Visible"/>
                </MultiTrigger>
                <Trigger Property="local:TextBoxAssist.HasError" Value="True">
                  <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ErrorBrush}"/>
                  <Setter TargetName="Bd" Property="BorderThickness" Value="0 0 0 2"/>
                  <Setter TargetName="ErrorText" Property="Visibility" Value="Visible"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/>
                  <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                  <Setter TargetName="ClearButton" Property="Visibility" Value="Collapsed"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Numeric TextBox (with up/down arrows) -->
      <Style x:Key="NumberTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource TextBoxStyle}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="TextBox">
              <StackPanel>
                <Border x:Name="Bd" Background="{StaticResource InputBackgroundBrush}" CornerRadius="3 3 0 0"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0 0 0 1" MinHeight="44">
                  <Grid Margin="10 4 2 4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" FontSize="11"
                               Text="{TemplateBinding local:TextBoxAssist.Hint}"
                               Foreground="{StaticResource SecondaryTextBrush}"/>
                    <ScrollViewer x:Name="PART_ContentHost" Grid.Row="1" VerticalAlignment="Center"
                                  Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    <StackPanel Grid.Column="1" Grid.RowSpan="2" VerticalAlignment="Center">
                      <RepeatButton Content="▲" Tag="1" Click="SpinButton_Click" Style="{DynamicResource SpinButtonStyle}"/>
                      <RepeatButton Content="▼" Tag="-1" Click="SpinButton_Click" Style="{DynamicResource SpinButtonStyle}"/>
                    </StackPanel>
                  </Grid>
                </Border>
                <TextBlock x:Name="ErrorText" FontSize="11" Margin="10 2 0 0" TextWrapping="Wrap"
                           Text="{TemplateBinding local:TextBoxAssist.ErrorMessage}"
                           Foreground="{StaticResource ErrorBrush}" Visibility="Collapsed"/>
              </StackPanel>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{StaticResource InputHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                  <Setter TargetName="Bd" Property="BorderThickness" Value="0 0 0 2"/>
                </Trigger>
                <Trigger Property="local:TextBoxAssist.HasError" Value="True">
                  <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ErrorBrush}"/>
                  <Setter TargetName="Bd" Property="BorderThickness" Value="0 0 0 2"/>
                  <Setter TargetName="ErrorText" Property="Visibility" Value="Visible"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/>
                  <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="SpinButtonStyle" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Width" Value="22"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="RepeatButton">
              <Border Background="Transparent">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Toggle switch -->
      <Style x:Key="ToggleSwitchStyle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ToggleButton">
              <StackPanel Orientation="Horizontal" Background="Transparent">
                <Grid Width="40" Height="20" VerticalAlignment="Center">
                  <Border x:Name="Track" CornerRadius="10" Background="#555555"/>
                  <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="White"
                           HorizontalAlignment="Left" Margin="3 0"/>
                </Grid>
                <ContentPresenter Margin="10 0 0 0" VerticalAlignment="Center"/>
              </StackPanel>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}"/>
                  <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Pill buttons -->
      <Style x:Key="PillButtonBaseStyle" TargetType="Button">
        <Setter Property="Height" Value="32"/>
        <Setter Property="MinWidth" Value="80"/>
        <Setter Property="Padding" Value="16 0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Bd" CornerRadius="16" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                      Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="PillPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PillButtonBaseStyle}">
        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        <Setter Property="Foreground" Value="#141414"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Style.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="PillSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PillButtonBaseStyle}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryTextBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Style.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter Property="Background" Value="{StaticResource InputHoverBrush}"/>
          </Trigger>
        </Style.Triggers>
      </Style>

      <!-- Progress bar -->
      <Style x:Key="ProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="Height" Value="4"/>
        <Setter Property="Background" Value="#444444"/>
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
      </Style>
    </ResourceDictionary>
  </Window.Resources>

  <Grid Background="{StaticResource PageBackgroundBrush}">

    <Grid.RowDefinitions>
      <RowDefinition Height="2*"/>
      <RowDefinition Height="2*"/>
      <RowDefinition Height="*" MinHeight="150"/>
    </Grid.RowDefinitions>

    <HeaderedContentControl Grid.Row="0" Margin="10 5" Style="{StaticResource CardStyle}"
                            Header="Available RBE Models">
      <DataGrid x:Name="datagrid" Height="180"
                HeadersVisibility="None" RowDetailsVisibilityMode="Collapsed"
                ItemsSource="{Binding RBE_Models}" d:ItemsSource="{d:SampleData}"
                SelectionMode="Single" SelectedItem="{Binding SelectedRBEModel, Mode=TwoWay}"
                IsEnabled="{Binding Calculating, Converter={StaticResource InverterConverter}}"
                Style="{StaticResource DataGridStyle}"
                AutoGenerateColumns="False" CanUserAddRows="False">
        <DataGrid.Columns>
          <DataGridTemplateColumn Width="*">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Name}" TextWrapping="Wrap"
                           Style="{StaticResource Body1TextStyle}"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <DataGridTemplateColumn Width="3*">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                           Style="{StaticResource Body2TextStyle}"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <DataGridTemplateColumn Width="2*">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock TextWrapping="Wrap" TextDecorations="Underline" Cursor="Hand"
                           Text="{Binding Reference}" ToolTip="Click to Copy"
                           Style="{StaticResource Body2TextStyle}" Foreground="LightGray"
                           MouseLeftButtonDown="TextBlock_Reference_MouseLeftButtonUp"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </HeaderedContentControl>

    <HeaderedContentControl Grid.Row="1" Margin="10 5" Style="{StaticResource CardStyle}"
                            Header="{Binding SelectedRBEModel.Name}" d:Header="Selected Model Name">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="3*"/>
          <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBox Grid.Row="0" Margin="0 0 0 10"
                   local:TextBoxAssist.Hint="Plan ID" Text="{Binding SelectedRBEModel.PlanId, Mode=OneWay}"
                   local:TextBoxAssist.HasError="{Binding IsPlanIdValid, Converter={StaticResource InverterConverter}}"
                   local:TextBoxAssist.ErrorMessage="{Binding PlanIdValidationMessage, Mode=OneWay}"
                   TextChanged="TextBox_PlanId_TextChanged"
                   IsEnabled="{Binding Calculating, Converter={StaticResource InverterConverter}}"
                   Style="{StaticResource TextBoxStyle}"
                   local:TextBoxAssist.ShowClearButton="True"/>

          <TextBox Grid.Row="1" Margin="0 0 0 10"
                   local:TextBoxAssist.Hint="Plan Name" Text="{Binding SelectedRBEModel.PlanName, Mode=TwoWay}"
                   IsEnabled="{Binding Calculating, Converter={StaticResource InverterConverter}}"
                   Style="{StaticResource TextBoxStyle}"
                   local:TextBoxAssist.ShowClearButton="True"/>

          <TextBox Grid.Row="2" Margin="0 0 0 10"
                   local:TextBoxAssist.Hint="Plan Comment" Text="{Binding SelectedRBEModel.PlanComment, Mode=TwoWay}"
                   IsEnabled="{Binding Calculating, Converter={StaticResource InverterConverter}}"
                   Style="{StaticResource TextBoxStyle}"
                   TextWrapping="Wrap"
                   local:TextBoxAssist.ShowClearButton="True"/>
        </Grid>

        <ItemsControl Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                      ItemsSource="{Binding SelectedRBEModel.CalculationParameters}" d:ItemsSource="{d:SampleData}"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBox local:TextBoxAssist.Hint="{Binding Name}" Text="{Binding ValueString, Mode=OneWay}" d:Text="10.0"
                       Tag="{Binding Name}"
                       Width="Auto" MinWidth="150"
                       Margin="20 0 0 10" HorizontalAlignment="Stretch"
                       IsEnabled="{Binding Calculating, Converter={StaticResource InverterConverter}}"
                       Style="{StaticResource TextBoxStyle}"
                       TextChanged="TextBox_Parameter_TextChanged"
                       local:TextBoxAssist.HasError="{Binding IsValueValid, Converter={StaticResource InverterConverter}}"
                       local:TextBoxAssist.ErrorMessage="{Binding ValueValidationMessage}"
                       local:TextBoxAssist.ShowClearButton="False"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </HeaderedContentControl>

    <HeaderedContentControl Grid.Row="2" Margin="10" Style="{StaticResource CardStyle}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="250"/>
          <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <ToggleButton Grid.Row="0"
                        HorizontalAlignment="Left"
                        Content="Plan dose is RBE Weighted"
                        IsEnabled="{Binding Calculating, Converter={StaticResource InverterConverter}}"
                        Style="{StaticResource ToggleSwitchStyle}"
                        IsChecked="{Binding PlanDoseIsRBEWeighted}" d:IsChecked="True"/>

          <TextBox Grid.Row="1" Width="150"
                   HorizontalAlignment="Left" Margin="50 10 0 0"
                   local:TextBoxAssist.Hint="RBE Factor"
                   Text="{Binding PlanDoseRBEWeight}" d:Text="1.1"
                   Visibility="{Binding PlanDoseIsRBEWeighted, Converter={StaticResource BooleanToVisibleConverter}}"
                   IsEnabled="{Binding Calculating, Converter={StaticResource InverterConverter}}"
                   Style="{StaticResource NumberTextBoxStyle}"
                   local:TextBoxAssist.HasError="{Binding IsPlanDoseRBEWeightValid, Converter={StaticResource InverterConverter}}"
                   local:TextBoxAssist.ErrorMessage="{Binding PlanDoseRBEWeightValidationMessage, Mode=OneWay}"
                   local:TextBoxAssist.Minimum="0.0" local:TextBoxAssist.Maximum="10"
                   local:TextBoxAssist.Step="0.1"/>
        </Grid>

        <Grid Grid.Column="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0" Width="200"
                      HorizontalAlignment="Right" VerticalAlignment="Center"
                      Visibility="{Binding Calculating, Converter={StaticResource BooleanToVisibleConverter}}">
            <ProgressBar x:Name="ProgressBar" Style="{StaticResource ProgressBarStyle}"
                         Minimum="0" Maximum="100"
                         Value="{Binding ProgressPercent, Mode=OneWay}" d:Value="36"/>
            <TextBlock Margin="0 4 0 0" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"
                       Text="{Binding ProgressMessage}" d:Text="Calculating..."/>
          </StackPanel>

          <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Close"
                    Click="Button_Close_Click"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    IsEnabled="{Binding Calculating, Converter={StaticResource InverterConverter}}"
                    Style="{StaticResource PillSecondaryButtonStyle}"/>

            <Button Content="Apply" Margin="20 0 0 0"
                    Command="{Binding ApplyCommand}"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    IsEnabled="{Binding CanStartCalculation}"
                    Style="{StaticResource PillPrimaryButtonStyle}"/>
          </StackPanel>
        </Grid>
      </Grid>
    </HeaderedContentControl>

    <!-- Notification area -->
    <StackPanel x:Name="NotificationArea" Grid.RowSpan="3"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="20"
                IsHitTestVisible="False"/>
  </Grid>
</Window>
